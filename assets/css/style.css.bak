@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap');

:root {
	--ink: #172523;
	--paper: #f4f1e9;
	--lime: #d5ef58;
	--coral: #fa735f;
	--blue: #687de8;
	--line: rgba(23, 37, 35, .18);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; color: var(--ink); background: var(--paper); font-family: 'Outfit', sans-serif; }
a { color: inherit; text-decoration: none; }
.site-header { align-items: center; display: flex; justify-content: space-between; margin: auto; max-width: 1240px; padding: 28px 38px; position: relative; z-index: 2; }
.logo { align-items: center; background: var(--ink); color: var(--lime); display: flex; font-size: 27px; font-weight: 700; height: 46px; justify-content: center; letter-spacing: -4px; width: 46px; }
.logo span { color: var(--coral); font-size: 20px; margin-left: 3px; }
nav ul { align-items: center; display: flex; gap: 34px; list-style: none; margin: 0; padding: 0; }
nav a { font-size: 14px; font-weight: 600; }
nav a:hover, .text-link:hover { color: var(--coral); }
.nav-contact { border-bottom: 1px solid var(--ink); padding-bottom: 5px; }
nav span, .button span, .text-link span, .contact-email span { color: var(--coral); margin-left: 8px; }
.hero { min-height: 650px; margin: 0 auto; max-width: 1240px; overflow: hidden; padding: 82px 38px 120px; position: relative; }
.hero-copy { max-width: 620px; position: relative; z-index: 1; }
.eyebrow, .section-label { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; }
.eyebrow span { background: var(--coral); border-radius: 50%; display: inline-block; height: 8px; margin-right: 9px; width: 8px; }
h1, h2 { font-size: clamp(58px, 7.5vw, 108px); font-weight: 500; letter-spacing: -5px; line-height: .93; margin: 28px 0; }
em { color: var(--coral); font-family: Georgia, serif; font-weight: 400; }
.hero-text { font-size: 18px; line-height: 1.45; max-width: 330px; }
.hero-actions { display: flex; gap: 26px; margin-top: 36px; }
.button { font-size: 14px; font-weight: 600; padding: 15px 20px; }
.button-primary { background: var(--ink); color: var(--paper); }
.button-primary:hover { background: var(--coral); }
.button-quiet { border-bottom: 1px solid var(--ink); padding-left: 0; padding-right: 0; }
.hero-art { height: 470px; position: absolute; right: 25px; top: 82px; width: 470px; }
.art-orbit { border: 1px solid var(--ink); border-radius: 50%; height: 360px; left: 50px; position: absolute; top: 35px; transform: rotate(-28deg); width: 200px; }
.orbit-two { border-color: var(--coral); height: 170px; left: 168px; top: 140px; transform: rotate(48deg); width: 310px; }
.art-square { background: var(--lime); height: 230px; position: absolute; right: 20px; top: 118px; transform: rotate(14deg); width: 230px; }
.art-note { font-family: 'DM Mono', monospace; font-size: 13px; left: 130px; line-height: 1.5; position: absolute; top: 205px; transform: rotate(-13deg); z-index: 1; }
.art-note strong { color: var(--coral); font-size: 10px; font-weight: 400; }
.art-number { bottom: 74px; font-family: 'DM Mono', monospace; font-size: 12px; position: absolute; right: 36px; }
.profile-card { align-items: center; background: var(--coral); bottom: 58px; display: flex; gap: 12px; padding: 17px 20px; position: absolute; right: 145px; width: 310px; z-index: 2; }
.profile-avatar { align-items: center; background: var(--ink); color: var(--lime); display: flex; font-size: 20px; height: 42px; justify-content: center; width: 42px; }
.profile-avatar span { color: var(--coral); font-size: 10px; margin-left: 2px; }
.profile-card strong, .profile-card small { display: block; }.profile-card strong { font-size: 14px; }.profile-card small { font-size: 12px; margin-top: 3px; }
.available { font-family: 'DM Mono', monospace; font-size: 9px; margin-left: auto; text-transform: uppercase; }.available i { background: var(--lime); border-radius: 50%; display: inline-block; height: 6px; margin-right: 4px; width: 6px; }
.scroll-hint { bottom: 25px; font-family: 'DM Mono', monospace; font-size: 10px; left: 38px; position: absolute; text-transform: uppercase; }.scroll-hint span { color: var(--coral); font-size: 18px; margin-left: 8px; }
.section-wrap { border-top: 1px solid var(--line); margin: 0 auto; max-width: 1164px; padding: 74px 0 115px; position: relative; }
.section-label { margin: 0; }.about-content { display: grid; gap: 14%; grid-template-columns: 1fr 1fr; margin-top: 32px; }.about h2, .section-heading h2, .contact h2 { font-size: clamp(51px, 6.5vw, 84px); margin: 0; }.about-content > div { align-self: end; max-width: 365px; }.about-content p, .section-heading > p:last-child { color: #52625e; font-size: 16px; line-height: 1.6; }.text-link { display: inline-block; font-size: 14px; font-weight: 600; margin-top: 20px; padding-bottom: 7px; border-bottom: 1px solid var(--ink); }.about-mark { color: var(--coral); font-size: 92px; position: absolute; right: 5%; top: 60px; transform: rotate(15deg); }
.work { display: grid; gap: 12%; grid-template-columns: .7fr 1.3fr; }.section-heading { position: relative; }.section-heading > p:last-child { max-width: 230px; }.project-grid { display: grid; gap: 22px; grid-template-columns: 1.2fr .8fr; padding-top: 14px; }.project-image { align-items: center; display: flex; height: 310px; justify-content: center; overflow: hidden; position: relative; }.project-image-blue { background: var(--blue); }.project-image-blue span { color: var(--paper); font-size: 70px; font-weight: 700; letter-spacing: -7px; transform: rotate(-12deg); }.project-image b { font-size: 30px; position: absolute; right: 20px; top: 16px; }.project-image-yellow { background: var(--lime); }.project-image-yellow span { font-family: Georgia, serif; font-size: 34px; line-height: .88; transform: rotate(9deg); }.project-image-yellow b { color: var(--coral); font-size: 27px; left: 20px; position: absolute; top: 18px; }.project-info { align-items: start; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; padding: 14px 0; }.project-info strong, .project-info small { display: block; }.project-info small, .project-info > span { color: #65726d; font-family: 'DM Mono', monospace; font-size: 10px; margin-top: 5px; }.project-info strong { font-size: 15px; }.project:hover .project-image { transform: translateY(-5px); transition: transform .25s ease; }
.contact { padding-bottom: 90px; }.contact h2 { margin-top: 36px; }.contact-email { border-bottom: 1px solid var(--ink); display: inline-block; font-size: 20px; margin-top: 20px; padding-bottom: 8px; }.contact-email:hover { color: var(--coral); }
footer { border-top: 1px solid var(--line); display: flex; font-family: 'DM Mono', monospace; font-size: 10px; justify-content: space-between; margin: auto; max-width: 1164px; padding: 22px 0 35px; text-transform: uppercase; }footer a:hover { color: var(--coral); }
@media (max-width: 800px) { .site-header { padding: 22px 20px; }.site-header nav li:not(:last-child) { display: none; }.hero { min-height: 720px; padding: 60px 20px 100px; }.hero-art { opacity: .52; right: -115px; top: 205px; transform: scale(.82); }.profile-card { bottom: 64px; left: 20px; right: auto; width: calc(100% - 40px); }.scroll-hint { left: 20px; }.section-wrap { margin: 0 20px; padding: 55px 0 75px; }.about-content, .work { display: block; }.about-content > div { margin-top: 34px; }.about-mark { font-size: 55px; right: 10px; top: 48px; }.section-heading { margin-bottom: 34px; }.project-grid { grid-template-columns: 1fr; }.project-secondary { display: none; }.project-image { height: 260px; }footer { gap: 12px; margin: 0 20px; }footer span:nth-child(2) { display: none; } }
